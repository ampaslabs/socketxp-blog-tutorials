{
  "uid": "mqtt-iot-fleet",
  "title": "MQTT IoT Fleet",
  "tags": [
    "mqtt",
    "iot"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"telemetry\", tag: \"site\")"
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(\n  bucket: \"telemetry\",\n  tag: \"device_id\",\n  predicate: (r) => r.site == \"${site}\",\n)"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Devices reporting (last 2 min)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"uptime\")\n  |> filter(fn: (r) => r.site == \"${site}\")\n  |> last()\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      }
    },
    {
      "type": "stat",
      "title": "Devices known (7 days)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"uptime\")\n  |> filter(fn: (r) => r.site == \"${site}\")\n  |> last()\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      }
    },
    {
      "type": "state-timeline",
      "title": "Online / offline",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"status\" and r._field == \"up\")\n  |> filter(fn: (r) => r.site == \"${site}\" and r.device_id =~ /^${device:regex}$/)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.device_id}",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Online",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Offline",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true
      },
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      }
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"cpu\")\n  |> filter(fn: (r) => r.site == \"${site}\" and r.device_id =~ /^${device:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.device_id}",
          "unit": "percent"
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      }
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"mem\")\n  |> filter(fn: (r) => r.site == \"${site}\" and r.device_id =~ /^${device:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.device_id}",
          "unit": "percent"
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      }
    },
    {
      "type": "timeseries",
      "title": "Disk",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"disk\")\n  |> filter(fn: (r) => r.site == \"${site}\" and r.device_id =~ /^${device:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.device_id}",
          "unit": "percent"
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      }
    },
    {
      "type": "timeseries",
      "title": "Temperature",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"temp\")\n  |> filter(fn: (r) => r.site == \"${site}\" and r.device_id =~ /^${device:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.device_id}",
          "unit": "celsius",
          "noValue": "No temperature sensor on this device (normal in Docker)"
        },
        "overrides": []
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      }
    },
    {
      "type": "table",
      "title": "Last seen",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"uptime\")\n  |> filter(fn: (r) => r.site == \"${site}\")\n  |> last()\n  |> group()\n  |> keep(columns: [\"device_id\", \"fw\", \"_time\"])\n  |> sort(columns: [\"_time\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "_time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "displayName",
                "value": "Last seen"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "device_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Device"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fw"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Firmware"
              }
            ]
          }
        ]
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      }
    },
    {
      "type": "table",
      "title": "Fullest disks right now",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"disk\")\n  |> filter(fn: (r) => r.site == \"${site}\")\n  |> last()\n  |> group()\n  |> keep(columns: [\"device_id\", \"_value\"])\n  |> sort(columns: [\"_value\"], desc: true)\n  |> limit(n: 10)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "_value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Disk used"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "device_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Device"
              }
            ]
          }
        ]
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      }
    },
    {
      "type": "timeseries",
      "title": "Broker health ($SYS)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mosquitto\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)\n  |> fill(usePrevious: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.topic}",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      }
    },
    {
      "type": "timeseries",
      "title": "ESP32 minimum free heap, all sites (leak watch)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"heap_min\")\n  |> aggregateWindow(every: v.windowPeriod, fn: min, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.device_id}",
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": []
      },
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      }
    }
  ]
}