# Copy to .env and change every value. Never commit .env.
INFLUX_PASSWORD=change-me-influx-admin
INFLUX_TOKEN=change-me-long-random-token
GRAFANA_ADMIN_PASSWORD=change-me-grafana

MQTT_TELEGRAF_PASSWORD=change-me-telegraf
MQTT_WATCHDOG_PASSWORD=change-me-watchdog
# Demo only: all simulated devices share one password. Use one per device in production.
MQTT_DEVICE_PASSWORD=change-me-device
MQTT_GATEWAY_PASSWORD=change-me-gateway

# Optional: Slack / Teams / any JSON webhook for watchdog alerts
WEBHOOK_URL=
